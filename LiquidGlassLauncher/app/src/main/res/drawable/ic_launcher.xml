<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF3A6BFF" android:centerColor="#FF7B4DFF" android:endColor="#FFFF6FB5" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item android:left="22dp" android:top="22dp" android:right="22dp" android:bottom="22dp">
        <shape android:shape="oval">
            <solid android:color="#66FFFFFF" />
            <stroke android:width="2dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
